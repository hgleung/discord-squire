# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Discord ---

# Bot token, from the Developer Portal → your app → Bot → Reset Token.
# Treat this like a password: anyone holding it can act as your bot.
DISCORD_TOKEN=

# No DISCORD_GUILD_ID: the bot registers its commands in every server it's a
# member of (instantly, on login, and again the moment it joins a new one),
# so inviting it somewhere new works without touching this file.

# Your own user ID (right-click yourself → Copy User ID). When set, only you
# can run any command; anyone else gets a private refusal. Leave blank to open
# the bot to the whole server.
DISCORD_ADMIN_ID=

# --- Obsidian vault ---

# Your Obsidian vault folder. The training log lives in it as markdown, and
# the assistant saves task reports and notes there and can search your notes.
# Squire only writes inside its own folder in the vault.
OBSIDIAN_VAULT=C:/Users/you/Documents/My Vault
# Optional. Squire's folder inside the vault; "Squire" by default.
OBSIDIAN_FOLDER=

# --- Training log module ---

# The log is markdown under <vault>/Squire/Training: one note per workout in
# Workouts/, one per split in Splits/, settings in Training.md. Edit them in
# Obsidian freely; ticking a set's checkbox marks it done. To bring over an
# old JSON log once: npm run training:import -- <old.json> "<vault>/Squire/Training"

# Local model for /week summaries. Must be a model you have pulled in Ollama.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Optional web UI ---

# Set to serve the training log's browser UI (see web/). Leave blank to run
# the bot without it. The web dev server proxies /api to this port.
WEB_PORT=4000

# --- Music module (optional) ---
# Age-restricted videos need a signed-in YouTube session or yt-dlp skips them
# with "Sign in to confirm your age". Pick one:
#   a cookies.txt exported from a logged-in browser (Netscape format), or
#   a browser whose profile yt-dlp may read cookies from directly.
# Use a throwaway Google account, not your main one: streaming this way is
# against YouTube's ToS, and cookie auth means any enforcement lands on the
# account, not just an IP. To point at a specific browser profile rather than
# the default one, append ":<profile name or full path>", e.g. firefox:work
# — but note Firefox's "rename profile" (about:profiles) only changes the
# display label, not the on-disk folder or profiles.ini entry, so a renamed
# profile often isn't resolvable by name. When in doubt, use the full path to
# the profile folder instead, e.g. firefox:C:\Users\you\AppData\Roaming\
# Mozilla\Firefox\Profiles\xxxxxxxx.profilename
# Chrome 127+'s App-Bound Encryption blocks yt-dlp from reading its cookies
# at all — use Firefox instead.
YOUTUBE_COOKIES=
YOUTUBE_COOKIES_FROM_BROWSER=

# --- Assistant (optional) ---
# A chat assistant that answers anything you type in these channels — no
# slash command — and can search the web and set reminders. Comma-separated
# channel IDs (right-click a channel → Copy Channel ID). Leave blank to turn
# it off. With DISCORD_ADMIN_ID set it only answers you.
#
# Turning it on needs "Message Content Intent" switched on under Developer
# Portal → your app → Bot → Privileged Gateway Intents, or Discord refuses
# the login.
ASSISTANT_CHANNEL_IDS=

# From console.anthropic.com → API Keys. Required when the assistant is on.
ANTHROPIC_API_KEY=

# Optional. The model for chat replies: claude-haiku-5-5 by default, for speed.
ASSISTANT_MODEL=
# Optional. The model background tasks use for real work (research, planning):
# claude-sonnet-5-5 by default. The assistant picks per task; simple watch
# jobs run on ASSISTANT_MODEL instead.
ASSISTANT_TASK_MODEL=
# Optional. How hard it thinks: low (default), medium, high.
ASSISTANT_EFFORT=
# Optional. Your default location, for weather, "near me" and the like:
# "City, State" or "City, Region, CC" (two-letter country, US by default).
ASSISTANT_LOCATION=
# Optional. Anything the assistant should always know about you, in one line,
# e.g. "Works downtown and commutes from home on weekdays."
ASSISTANT_ABOUT_ME=
# Optional. Your time zone for reminders; defaults to this PC's.
ASSISTANT_TIMEZONE=
# Optional. Where reminders and background tasks are kept; default to
# data/reminders.json and data/tasks.json in this folder.
REMINDERS_FILE=
TASKS_FILE=
# Optional. Where long-term memories are kept; defaults to data/memory.json.
MEMORY_FILE=

# --- Gmail and Google Calendar (optional) ---
# Lets the assistant search and read your mail, save drafts (never send), and
# read and edit your calendar. One-time setup:
#   1. console.cloud.google.com → new project → enable "Gmail API" and
#      "Google Calendar API".
#   2. OAuth consent screen: External; add yourself as a test user. Tokens of
#      an app left in "Testing" expire after 7 days, so publish it (you'll see
#      an "unverified app" warning when you sign in, which is fine for you).
#   3. Credentials → Create OAuth client ID → Desktop app. Paste below.
#   4. npm run google:auth, and tick every box on Google's consent page.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Where the sign-in is kept; defaults to data/google-token.json.
GOOGLE_TOKEN_FILE=

# --- Saved Google Maps lists (optional) ---
# Your Google Maps lists (Food, Bars, ...) for recommendations. Google has no
# API for saved lists, so each is read from its share link: in Maps, open the
# list → Share → "Anyone with the link" → copy the link. Comma-separated.
# This uses an unofficial endpoint and may break if Google changes it; the
# bot keeps the last good copy. Re-read every 6 hours; nothing is written back
# to Google Maps.
MAPS_LIST_URLS=
# Optional. For hours ("open now"), ratings, price, "near <somewhere>",
# adding spots by chat, and trip suggestions. In the same Cloud project:
# enable "Places API (New)", turn on billing, then Credentials → Create API
# key, restricted to Places API (New). Each place is looked up once and again
# monthly, well inside Google's free monthly allowance for a few hundred places.
GOOGLE_MAPS_API_KEY=
# Optional. Where the lists are cached; defaults to data/places.json.
PLACES_FILE=
